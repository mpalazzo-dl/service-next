# Production / deployment
.vercel
.turbo

# Environment — real credentials must never be committed.
# `.env.example` is the checked-in template and is kept below.
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Storybook static build
storybook-static/

# Contentful CLI artefacts.
# `commands/json/*.json` IS committed: `create-site` imports the model and
# content from it, and `commands/json/images.ctfassets.net/` holds the asset
# binaries that import needs. Only the error logs are noise.
contentful-import-error-log-*.json
contentful-export-*.json

# Testing
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

